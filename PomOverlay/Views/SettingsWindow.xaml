<Window x:Class="PomOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PomOverlay"
        Title="PomOverlay 設定" Width="560" Height="560" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,12,4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="適用" Width="88" Margin="0,0,8,0" Click="OnApply" />
                <Button Content="閉じる" Width="88" Click="OnClose" />
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="Gray" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <TabControl>
            <TabItem Header="全般">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource Label}" Text="切り替えのフェード (秒)" />
                    <TextBox Grid.Column="1" Text="{Binding TransitionSec}" />

                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="更新回数 (FPS、1～60)" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Fps}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Label}" Margin="12,4,0,4"
                               Foreground="Gray" Text="下げるほど軽くなります" />
                </Grid>
            </TabItem>

            <TabItem Header="モード">
                <TabControl Margin="8" ItemsSource="{Binding Modes}" SelectedIndex="0">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Style="{StaticResource Label}" Text="時間 (分)" />
                                <TextBox Grid.Column="1" Text="{Binding Min}" />

                                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="線の太さ (px)" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Thick}" />

                                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="ぼかし 最小 (px)" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding BlurMin}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Label}" Margin="16,4,12,4" Text="最大" />
                                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding BlurMax}" />

                                <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="不透明度 最小 (0～1)" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding OpMin}" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Label}" Margin="16,4,12,4" Text="最大" />
                                <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding OpMax}" />

                                <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="明滅の周期 (秒)" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding PulseSec}" />

                                <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="流れの周期 (秒)" />
                                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding FlowDuration}" />

                                <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="色 (カンマ区切り)" />
                                <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding ColorsText}" />

                                <TextBlock Grid.Row="7" Grid.ColumnSpan="5" Margin="0,12,0,0" Foreground="Gray" TextWrapping="Wrap"
                                           Text="時間は Focus / Rest のサイクルでだけ使われます。色は Red や #FF8800 のように書きます。" />
                            </Grid>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </TabItem>

            <TabItem Header="スケジュール">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="追加" Width="72" Margin="0,0,8,0" Click="OnAddSchedule" />
                        <Button Content="削除" Width="72" Click="OnRemoveSchedule" />
                        <TextBlock Style="{StaticResource Label}" Margin="12,0,0,0" Foreground="Gray"
                                   Text="時刻は 00:00 形式。上にあるものが優先されます" />
                    </StackPanel>
                    <DataGrid x:Name="SchedulesGrid" ItemsSource="{Binding Schedules}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="開始" Binding="{Binding Start}" Width="*" />
                            <DataGridTextColumn Header="終了" Binding="{Binding End}" Width="*" />
                            <DataGridComboBoxColumn Header="モード" Width="*"
                                                    ItemsSource="{x:Static local:SettingsViewModel.ScheduleModes}"
                                                    SelectedItemBinding="{Binding ApplyMode}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
